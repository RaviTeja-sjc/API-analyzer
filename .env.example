# ==============================================================================
# API Analyzer - Production Environment Variables Template
# NEVER COMMIT THE ACTUAL .env FILE!
# ==============================================================================

# Server
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database (Supabase Session Pooler)
# MUST append ?sslmode=require for Supabase external connections
DATABASE_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USER=your_supabase_pooler_username
DATABASE_PASSWORD=your_supabase_secure_password

# Security (JWT and Database AES Encryption)
# JWT_SECRET MUST be a Base64 encoded string representing at least 32 bytes (256 bits).
# Generate a secure key using: openssl rand -base64 32
JWT_SECRET=replace_with_secure_base64_jwt_secret_here=

# DB_ENCRYPTION_KEY MUST be exactly 16, 24, or 32 raw text characters/bytes.
# E.g. exactly 32 raw characters.
DB_ENCRYPTION_KEY=replace_with_32_byte_raw_text_key

# CORS Configuration (Comma separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
