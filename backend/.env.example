# ==============================================================================
# API Analyzer - Production Environment Variables Template
# NEVER COMMIT THE ACTUAL .env FILE!
# ==============================================================================

# Server
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database (PostgreSQL)
DATABASE_URL=jdbc:postgresql://your-production-db-host:5432/api_analyzer
DATABASE_USER=your_db_username
DATABASE_PASSWORD=your_secure_db_password

# Security (JWT and Database AES Encryption)
# Generate a secure 256-bit hex key for JWT (e.g., openssl rand -hex 32)
JWT_SECRET=replace_with_secure_jwt_secret

# Exactly 16, 24, or 32 bytes for AES encryption key
DB_ENCRYPTION_KEY=replace_with_32_byte_aes_key____

# CORS Configuration (Comma separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
